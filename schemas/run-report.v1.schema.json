{
  "$id": "https://github.com/PodUtils/podcrates/blob/main/schemas/run-report.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunReport",
  "description": "The full report (`run-report.v1`), for the operator.",
  "type": "object",
  "properties": {
    "cache_read_bytes": {
      "description": "The bytes that the job read from and wrote to its cache (G-20).",
      "anyOf": [
        {
          "$ref": "#/$defs/Residual"
        },
        {
          "type": "null"
        }
      ]
    },
    "cache_written_bytes": {
      "anyOf": [
        {
          "$ref": "#/$defs/Residual"
        },
        {
          "type": "null"
        }
      ]
    },
    "claim_to_first_step_s": {
      "description": "The time from the claim to the hook of the job's first step, in\nseconds; absent when no step started. Not in the public report.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "cpu_s": {
      "description": "The CPU time of the processes of the unit, user and system, from its\nstart to its destroy, in seconds: a count, or `unknown` when the host\ncannot measure it (never 0 for unknown). Absent when no unit ran.",
      "anyOf": [
        {
          "$ref": "#/$defs/Residual"
        },
        {
          "type": "null"
        }
      ]
    },
    "destroy_s": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "disk_peak_bytes": {
      "description": "The highest use of the disk of the unit, in bytes (G-19, G-18).",
      "anyOf": [
        {
          "$ref": "#/$defs/Residual"
        },
        {
          "type": "null"
        }
      ]
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int32"
    },
    "exit_reason": {
      "$ref": "#/$defs/ExitReason"
    },
    "host": {
      "description": "The name of the host.",
      "type": "string"
    },
    "image_digest": {
      "description": "The digest of the image of the unit (`sha256:HEX`; G-19).",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "job_id": {
      "$ref": "#/$defs/JobId"
    },
    "job_images": {
      "description": "The digests of the images of the job (`sha256:` and 64 lower-case\nhex digits). Not in the public report.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "log_tail": {
      "description": "The end of the log of a unit that failed before the runner\nconnected: UTF-8, at most [`LOG_TAIL_MAX`] bytes, each credential\nscrubbed by the writer.",
      "type": [
        "string",
        "null"
      ]
    },
    "net_rx_bytes": {
      "description": "The bytes of the network of the unit, through its egress module.",
      "anyOf": [
        {
          "$ref": "#/$defs/Residual"
        },
        {
          "type": "null"
        }
      ]
    },
    "net_tx_bytes": {
      "anyOf": [
        {
          "$ref": "#/$defs/Residual"
        },
        {
          "type": "null"
        }
      ]
    },
    "peak_rss_mib": {
      "description": "The highest resident memory of the processes of the unit during the\nrun, in MiB: a count, or `unknown`. Absent when no unit ran.",
      "anyOf": [
        {
          "$ref": "#/$defs/Residual"
        },
        {
          "type": "null"
        }
      ]
    },
    "prepare_s": {
      "description": "The phases of the unit, in seconds, each rounded up as `cpu_s`: the\nprepare, the start, the run of the job and the destroy (G-19).",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "refusal_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/RefusalCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_s": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "runner_version": {
      "description": "The version of the runner in the unit (G-19).",
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "description": "The version of the record: `SCHEMA`, 1.",
      "type": "integer",
      "const": 1
    },
    "source": {
      "type": "string"
    },
    "start_s": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "tier": {
      "description": "The tier, when the tier rule gave one.",
      "anyOf": [
        {
          "$ref": "#/$defs/Tier"
        },
        {
          "type": "null"
        }
      ]
    },
    "unit": {
      "anyOf": [
        {
          "$ref": "#/$defs/UnitFields"
        },
        {
          "type": "null"
        }
      ]
    },
    "unknown_reasons": {
      "description": "For each measured field that is `unknown`: why, in one line. A kind\nthat cannot measure a fact says `unknown` with a reason, never 0.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "cpu_s",
          "peak_rss_mib",
          "disk_peak_bytes",
          "net_rx_bytes",
          "net_tx_bytes",
          "cache_read_bytes",
          "cache_written_bytes"
        ]
      }
    },
    "wall_s": {
      "description": "The time from the claim to the report, in seconds.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "refusal_code": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "exit_reason": {
            "const": "refused"
          }
        },
        "required": [
          "exit_reason"
        ]
      },
      "then": {
        "properties": {
          "refusal_code": {
            "not": {
              "type": "null"
            }
          },
          "unit": {
            "type": "null"
          }
        },
        "required": [
          "refusal_code"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "exit_reason": {
            "const": "withdrawn"
          }
        },
        "required": [
          "exit_reason"
        ]
      },
      "then": {
        "properties": {
          "unit": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "unknown_reasons": {
            "required": [
              "cpu_s"
            ]
          }
        },
        "required": [
          "unknown_reasons"
        ]
      },
      "then": {
        "properties": {
          "cpu_s": {
            "const": "unknown"
          }
        },
        "required": [
          "cpu_s"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "unknown_reasons": {
            "required": [
              "peak_rss_mib"
            ]
          }
        },
        "required": [
          "unknown_reasons"
        ]
      },
      "then": {
        "properties": {
          "peak_rss_mib": {
            "const": "unknown"
          }
        },
        "required": [
          "peak_rss_mib"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "unknown_reasons": {
            "required": [
              "disk_peak_bytes"
            ]
          }
        },
        "required": [
          "unknown_reasons"
        ]
      },
      "then": {
        "properties": {
          "disk_peak_bytes": {
            "const": "unknown"
          }
        },
        "required": [
          "disk_peak_bytes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "unknown_reasons": {
            "required": [
              "net_rx_bytes"
            ]
          }
        },
        "required": [
          "unknown_reasons"
        ]
      },
      "then": {
        "properties": {
          "net_rx_bytes": {
            "const": "unknown"
          }
        },
        "required": [
          "net_rx_bytes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "unknown_reasons": {
            "required": [
              "net_tx_bytes"
            ]
          }
        },
        "required": [
          "unknown_reasons"
        ]
      },
      "then": {
        "properties": {
          "net_tx_bytes": {
            "const": "unknown"
          }
        },
        "required": [
          "net_tx_bytes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "unknown_reasons": {
            "required": [
              "cache_read_bytes"
            ]
          }
        },
        "required": [
          "unknown_reasons"
        ]
      },
      "then": {
        "properties": {
          "cache_read_bytes": {
            "const": "unknown"
          }
        },
        "required": [
          "cache_read_bytes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "unknown_reasons": {
            "required": [
              "cache_written_bytes"
            ]
          }
        },
        "required": [
          "unknown_reasons"
        ]
      },
      "then": {
        "properties": {
          "cache_written_bytes": {
            "const": "unknown"
          }
        },
        "required": [
          "cache_written_bytes"
        ]
      }
    }
  ],
  "required": [
    "schema",
    "job_id",
    "source",
    "host",
    "exit_reason",
    "wall_s"
  ],
  "$defs": {
    "Boundary": {
      "description": "The boundary between a job and the host, weakest first. `redirect`\nrewrites file paths and is no isolation against hostile code.",
      "type": "string",
      "enum": [
        "none",
        "redirect",
        "confined",
        "guest"
      ]
    },
    "EgressHold": {
      "description": "How the network traffic of a unit reaches the egress broker.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "none",
            "enforced"
          ]
        },
        {
          "description": "A redirect that a payload can go around.",
          "type": "string",
          "const": "advisory"
        },
        {
          "description": "Read as `none`.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "ExitReason": {
      "description": "How a job ended.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "success",
            "failure",
            "cancelled",
            "timeout",
            "unit-failed"
          ]
        },
        {
          "description": "The unit ended the job over a bound of its limits (disk now).",
          "type": "string",
          "const": "limit"
        },
        {
          "description": "Refused before a unit started: the report has `refusal_code`.",
          "type": "string",
          "const": "refused"
        },
        {
          "description": "Withdrawn at `wait_deadline_s`.",
          "type": "string",
          "const": "withdrawn"
        },
        {
          "description": "The runner name or the job id of the `started` event did not agree.",
          "type": "string",
          "const": "job-mismatch"
        },
        {
          "description": "The runner lost the job (a restart from `claimed` on).",
          "type": "string",
          "const": "lost"
        }
      ]
    },
    "JobId": {
      "type": "string",
      "pattern": "^([A-Za-z0-9_-][A-Za-z0-9._-]{0,127}|\\.[A-Za-z0-9_-][A-Za-z0-9._-]{0,126}|\\.\\.[A-Za-z0-9._-]{1,126})$"
    },
    "Principal": {
      "description": "Units and the control plane run as one uid (`shared`) or not.",
      "type": "string",
      "enum": [
        "shared",
        "distinct",
        "unknown"
      ]
    },
    "RefusalCode": {
      "description": "Why the runner refuses a job.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "no-slot-of-kind",
            "image-stale",
            "event-not-allowed",
            "tier-mismatch",
            "tier-needs-guest",
            "boundary-not-available",
            "limit-not-enforceable",
            "hold-not-available",
            "egress-policy-unsupported",
            "arch-mismatch",
            "payload-not-pinned",
            "repo-scope-refused",
            "container-not-supported",
            "container-option-refused",
            "build-not-supported",
            "source-revoked",
            "credential-unavailable",
            "unit-start-failed"
          ]
        },
        {
          "description": "Reserved.",
          "type": "string",
          "const": "port-claimed"
        }
      ]
    },
    "Residual": {
      "description": "A count (of `destroy`, or of the use of a unit), or `unknown`.",
      "anyOf": [
        {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        {
          "$ref": "#/$defs/Unknown"
        }
      ]
    },
    "Tier": {
      "description": "The trust tier of a job. It comes from the trust inputs of an offer,\nnever from a label; `local` comes only from the configuration.",
      "oneOf": [
        {
          "description": "A pull request from a fork.",
          "type": "string",
          "const": "untrusted"
        },
        {
          "description": "A member job of a configured organization.",
          "type": "string",
          "const": "trusted"
        },
        {
          "description": "Set only by the configuration.",
          "type": "string",
          "const": "local"
        }
      ]
    },
    "UnitFields": {
      "description": "The unit of a job that ran.",
      "type": "object",
      "properties": {
        "boundary": {
          "$ref": "#/$defs/Boundary"
        },
        "egress_hold": {
          "$ref": "#/$defs/EgressHold"
        },
        "payload": {
          "description": "The digest of the payload.",
          "type": "string"
        },
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "residual_files": {
          "$ref": "#/$defs/Residual"
        },
        "residual_processes": {
          "description": "The processes and files that `destroy` left; `unknown` when it\ncould not count.",
          "$ref": "#/$defs/Residual"
        },
        "unit_id": {
          "$ref": "#/$defs/UnitId"
        },
        "unit_kind": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "unit_id",
        "unit_kind",
        "boundary",
        "principal",
        "egress_hold",
        "payload",
        "residual_processes",
        "residual_files"
      ]
    },
    "UnitId": {
      "type": "string",
      "pattern": "^u-[0-9]{1,20}$"
    },
    "Unknown": {
      "description": "The word `unknown`.",
      "type": "string",
      "enum": [
        "unknown"
      ]
    }
  }
}
