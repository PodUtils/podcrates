{
  "$id": "https://github.com/PodUtils/podcrates/blob/main/schemas/log.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One JSON log line of a tool of PodUtils",
  "description": "One object on each line. The classes and their exit codes are the table of crates/pod-core/README.md.",
  "type": "object",
  "properties": {
    "class": {
      "description": "The name of the `pod_core::Class` of a failure.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "usage",
        "config",
        "unavailable",
        "notfound",
        "tempfail",
        "timeout",
        "protocol",
        "refused",
        "revoked",
        "policy",
        "unsupported",
        "permission",
        "suite",
        null
      ]
    },
    "event": {
      "description": "A dotted name: `broker.connection`, `broker.job.load`,\n`broker.job.drop`.",
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"
    },
    "fields": {
      "description": "The values of the event, never a secret: an object, where a missing\nkey reads as `null`.",
      "type": "object"
    },
    "level": {
      "description": "One of [`pod_core::LOG_LEVELS`].",
      "type": "string",
      "enum": [
        "error",
        "warn",
        "info",
        "debug",
        "trace"
      ]
    },
    "schema": {
      "description": "The version of the log schema ([`pod_core::LOG_SCHEMA`]), the first\nkey.",
      "type": "integer",
      "const": 1
    },
    "stage": {
      "description": "The name of the `pod_core::Stage` of a failure.",
      "type": [
        "string",
        "null"
      ]
    },
    "time": {
      "description": "RFC 3339, UTC.",
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "time",
    "level",
    "event",
    "fields"
  ]
}
