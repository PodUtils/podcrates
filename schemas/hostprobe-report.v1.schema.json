{
  "$defs": {
    "WireFindings": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/$defs/WireIdentity"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/WireRow"
          },
          "type": "array"
        },
        "self_exe": {
          "type": "string"
        },
        "writable": {
          "items": {
            "$ref": "#/$defs/WireWrite"
          },
          "type": "array"
        }
      },
      "required": [
        "rows",
        "identity",
        "writable",
        "self_exe"
      ],
      "type": "object"
    },
    "WireIdentity": {
      "additionalProperties": false,
      "properties": {
        "cap_bnd": {
          "type": [
            "string",
            "null"
          ]
        },
        "cap_eff": {
          "type": [
            "string",
            "null"
          ]
        },
        "cap_prm": {
          "type": [
            "string",
            "null"
          ]
        },
        "gid": {
          "format": "int64",
          "type": "integer"
        },
        "gid_map": {
          "type": [
            "string",
            "null"
          ]
        },
        "groups": {
          "items": {
            "format": "int32",
            "type": "integer"
          },
          "type": "array"
        },
        "no_new_privs": {
          "type": [
            "string",
            "null"
          ]
        },
        "seccomp": {
          "type": [
            "string",
            "null"
          ]
        },
        "seccomp_filters": {
          "type": [
            "string",
            "null"
          ]
        },
        "setgroups": {
          "type": [
            "string",
            "null"
          ]
        },
        "threads": {
          "type": [
            "string",
            "null"
          ]
        },
        "uid": {
          "format": "int64",
          "type": "integer"
        },
        "uid_map": {
          "type": [
            "string",
            "null"
          ]
        },
        "unreadable": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "uid",
        "gid",
        "groups",
        "unreadable"
      ],
      "type": "object"
    },
    "WireRejection": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "type": "string"
        },
        "rung": {
          "enum": [
            "namespace",
            "supervise",
            "chroot",
            "userland",
            "interpose",
            "unsupported"
          ],
          "type": "string"
        }
      },
      "required": [
        "rung",
        "evidence"
      ],
      "type": "object"
    },
    "WireRow": {
      "additionalProperties": false,
      "if": {
        "properties": {
          "verdict": {
            "const": "denied"
          }
        }
      },
      "properties": {
        "errno": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "enum": [
            "unshare(CLONE_NEWNS)",
            "unshare(CLONE_NEWUSER)",
            "unshare(CLONE_NEWPID)",
            "clone(CLONE_NEWNS)",
            "clone(CLONE_NEWUTS|NEWNS)",
            "clone(CLONE_NEWUSER)",
            "clone(CLONE_NEWUTS)",
            "sethostname(in NEWUTS)",
            "mount(tmpfs,/mnt)",
            "mount(tmpfs,/mnt) in clone(NEWNS)",
            "mount(MS_SLAVE,/) in clone(NEWNS)",
            "pivot_root(/tmp,/tmp)",
            "ptrace(PTRACE_TRACEME)",
            "mknod(chr 1:3 /tmp/nodprobe)",
            "mknod(chr 0:0 = whiteout)",
            "setuid(1000)",
            "setuid(0)",
            "setgid(0)",
            "setgroups(0,NULL)",
            "chown(f,0,0)",
            "chown(f,0,42)",
            "lchown(f,0,42)",
            "chown(f,1000,0)",
            "chroot(/tmp)",
            "memfd_create",
            "memfd_create+exec",
            "setsid",
            "prctl(PR_SET_PDEATHSIG)",
            "exec(/tmp/execprobe)",
            "getrandom",
            "write(/etc/probe)",
            "write into uid-1000-owned dir",
            "stat(/dev/ptmx)",
            "open(/dev/ptmx, O_RDWR)",
            "open(/dev/fuse, O_RDWR)",
            "readdir(/)",
            "open(/bin, O_RDONLY) by name",
            "creat(/, O_CREAT|O_EXCL)",
            "bind(127.0.0.1:0)+listen",
            "mount(2) bogus target",
            "umount2(2) bogus target",
            "pivot_root(2) bogus paths",
            "process_vm_readv(bogus pid)",
            "pidfd_getfd(-1,-1) [control]",
            "kcmp(-1,-1,...) [control]",
            "fsopen(tmpfs)",
            "fsmount(tmpfs)",
            "open_tree(/tmp, CLONE)",
            "move_mount(-> bogus dest)",
            "move_mount(-> /tmp/mm-probe)",
            "openat(detached tmpfs, O_DIRECTORY)",
            "seccomp(NEW_LISTENER)",
            "open /proc/self/mem O_RDONLY",
            "open /proc/self/mem O_RDWR",
            "landlock_create_ruleset(VERSION)",
            "qemu-system-x86_64 --version",
            "open(/dev/kvm, O_RDWR)",
            "prlimit(RLIMIT_FSIZE)",
            "open(/dev/net/tun, O_RDWR)",
            "image space (statfs .)",
            "qemu-system-x86_64 -accel help",
            "seccomp(NEW_LISTENER) [supervise]",
            "process_vm_readv(own pid) [supervise]",
            "ptrace(PTRACE_TRACEME) [supervise]",
            "pidfd_open(own pid) [supervise]",
            "waitid(P_PIDFD, child) [supervise]"
          ],
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "verdict": {
          "enum": [
            "ok",
            "denied",
            "skip"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "verdict",
        "reason"
      ],
      "then": {
        "properties": {
          "errno": {
            "type": "integer"
          }
        },
        "required": [
          "errno"
        ]
      },
      "type": "object"
    },
    "WireSelection": {
      "additionalProperties": false,
      "properties": {
        "control_notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "controls_answered": {
          "type": "boolean"
        },
        "rejected": {
          "items": {
            "$ref": "#/$defs/WireRejection"
          },
          "type": "array"
        },
        "rung": {
          "enum": [
            "namespace",
            "supervise",
            "chroot",
            "userland",
            "interpose",
            "unsupported"
          ],
          "type": "string"
        }
      },
      "required": [
        "rung",
        "rejected",
        "controls_answered",
        "control_notes"
      ],
      "type": "object"
    },
    "WireSpace": {
      "additionalProperties": false,
      "properties": {
        "block_size": {
          "format": "int64",
          "type": "integer"
        },
        "blocks_free": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "inodes_free": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "blocks_free",
        "block_size",
        "inodes_free"
      ],
      "type": "object"
    },
    "WireWrite": {
      "additionalProperties": false,
      "if": {
        "properties": {
          "verdict": {
            "const": "denied"
          }
        }
      },
      "properties": {
        "errno": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "space": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireSpace"
            },
            {
              "type": "null"
            }
          ]
        },
        "space_errno": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "verdict": {
          "enum": [
            "ok",
            "denied",
            "skip"
          ],
          "type": "string"
        }
      },
      "required": [
        "path",
        "source",
        "verdict",
        "reason"
      ],
      "then": {
        "properties": {
          "errno": {
            "type": "integer"
          }
        },
        "required": [
          "errno"
        ]
      },
      "type": "object"
    }
  },
  "$id": "https://github.com/PodUtils/podcrates/blob/main/schemas/hostprobe-report.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "$ref": "#/$defs/WireFindings"
    },
    "schema": {
      "const": 1,
      "type": "integer"
    },
    "selection": {
      "$ref": "#/$defs/WireSelection"
    }
  },
  "required": [
    "schema",
    "findings",
    "selection"
  ],
  "title": "The report of pod-hostprobe",
  "type": "object"
}
