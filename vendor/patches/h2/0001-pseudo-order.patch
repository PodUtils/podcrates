+/// A pseudo-header field of a request (RFC 9113, section 8.3.1).
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Hash)]
+pub enum PseudoField {
+    /// `:method`
+    Method,
+    /// `:scheme`
+    Scheme,
+    /// `:authority`
+    Authority,
+    /// `:path`
+    Path,
+    /// `:protocol` (RFC 8441)
+    Protocol,
+}
+
+/// The order in which a request encodes its pseudo-header fields.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct PseudoOrder([PseudoField; 5]);
+
+impl PseudoOrder {
+    /// The order of h2: `:method`, `:scheme`, `:authority`, `:path`,
+    /// `:protocol`.
+    pub const DEFAULT: PseudoOrder = PseudoOrder([
+        PseudoField::Method,
+        PseudoField::Scheme,
+        PseudoField::Authority,
+        PseudoField::Path,
+        PseudoField::Protocol,
+    ]);
+
+    /// The fields of `first` in their order, then each other field in the
+    /// default order. A field that `first` repeats counts once.
+    pub fn new(first: &[PseudoField]) -> PseudoOrder {
+        let mut order = Self::DEFAULT.0;
+        let mut len = 0;
+        for field in first.iter().chain(Self::DEFAULT.0.iter()) {
+            if !order[..len].contains(field) {
+                order[len] = *field;
+                len += 1;
+            }
+        }
+        PseudoOrder(order)
+    }
+}
+
+impl Default for PseudoOrder {
+    fn default() -> PseudoOrder {
+        PseudoOrder::DEFAULT
+    }
+}
