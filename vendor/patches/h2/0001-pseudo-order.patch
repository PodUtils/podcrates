+/// Decodes one HPACK header block into its fields, in the order of the
+/// block. A test calls it to read the order of the fields on the wire.
+#[doc(hidden)]
+pub fn decode_header_block(block: &[u8]) -> Result<Vec<(String, String)>, String> {
+    use crate::hpack::Header;
+    use std::ops::ControlFlow;
+
+    let mut buffer = bytes::BytesMut::from(block);
+    let mut cursor = std::io::Cursor::new(&mut buffer);
+    let mut decoder = crate::hpack::Decoder::new(4096);
+    let mut fields = Vec::new();
+    decoder
+        .decode(&mut cursor, |header| {
+            let field = match header {
+                Header::Field { name, value } => (
+                    name.as_str().to_string(),
+                    value.to_str().unwrap_or_default().to_string(),
+                ),
+                Header::Authority(value) => (":authority".to_string(), value.as_str().to_string()),
+                Header::Method(value) => (":method".to_string(), value.as_str().to_string()),
+                Header::Scheme(value) => (":scheme".to_string(), value.as_str().to_string()),
+                Header::Path(value) => (":path".to_string(), value.as_str().to_string()),
+                Header::Protocol(value) => (":protocol".to_string(), value.as_str().to_string()),
+                Header::Status(value) => (":status".to_string(), value.as_str().to_string()),
+            };
+            fields.push(field);
+            ControlFlow::Continue(())
+        })
+        .map_err(|e| format!("{e:?}"))?;
+    Ok(fields)
+}
