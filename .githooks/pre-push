#!/bin/sh
# Refuse a push of a commit whose tree scripts/agent/check.sh did not pass
# (AGENTS.md, section 11: push only work that the checks verified).
# scripts/session-start.sh sets core.hooksPath to this directory.
#
# A full run of check.sh that passes writes the tree that it checked into
# .work/agent/checked-trees; a run with notest writes it into
# .work/agent/linted-trees. The push of a ref passes when the tree of its
# tip is a checked tree, or when it is a linted tree that differs from the
# last checked tree (else from the tree of the remote ref, which CI
# checked) only in TODO/ and docs/: the tests read no file there but
# docs/wire.md.
#
#   .githooks/pre-push REMOTE URL < REFS
#
# Exit 0: each ref may go. Exit 1: a ref has no check.
set -u
top=$(git rev-parse --show-toplevel) || exit 1
checked=$top/.work/agent/checked-trees
linted=$top/.work/agent/linted-trees
zero=0000000000000000000000000000000000000000
rc=0
while read -r _local sha _remote rsha; do
    # A delete of a remote ref pushes no tree.
    [ "$sha" = "$zero" ] && continue
    tree=$(git rev-parse "$sha^{tree}") || exit 1
    if [ -f "$checked" ] && grep -qx "$tree" "$checked"; then
        continue
    fi
    base=$(tail -n 1 "$checked" 2> /dev/null)
    if [ -z "$base" ] || ! git cat-file -e "$base" 2> /dev/null; then
        base=
        if [ "$rsha" != "$zero" ] && git cat-file -e "$rsha^{commit}" 2> /dev/null; then
            base=$(git rev-parse "$rsha^{tree}")
        fi
    fi
    if [ -n "$base" ] && [ -f "$linted" ] && grep -qx "$tree" "$linted"; then
        if ! changed=$(git diff --no-renames --name-only "$base" "$tree"); then
            echo "pre-push: git diff of $base and $tree failed" >&2
            rc=1
            continue
        fi
        other=$(printf '%s\n' "$changed" | grep -v -E '^(TODO|docs)/' | grep -v '^$')
        wire=$(printf '%s\n' "$changed" | grep -x 'docs/wire.md')
        if [ -z "$other" ] && [ -z "$wire" ]; then
            continue
        fi
        echo "pre-push: $sha changes files that only a full check covers:" >&2
        printf '%s\n%s\n' "$other" "$wire" | grep -v '^$' | head -20 >&2
    else
        echo "pre-push: check.sh did not pass the tree of $sha" >&2
    fi
    echo "pre-push: run sh scripts/agent/check.sh (notest for a change of TODO/ or docs/ alone), then push" >&2
    rc=1
done
exit "$rc"
