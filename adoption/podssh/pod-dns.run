# The trial of pod-dns and pod-services in podssh, in one patch: pod-dns
# reads its default resolvers from pod-services, and both take the place of
# constants in the same files. podssh-ws takes its resolver from pod-dns
# (resolve.rs stays as thin glue: one resolver for the process, with
# podssh's settings, its pins and its cache, and DNS over HTTPS straight at
# each resolver's address; the SRV records and the ECH list through the
# proxy of a road), and each crate reads the relay, its limits and its seed
# and each service of another party from pod-services. The record with its
# citations moved, and the repository checks; the library crates; the
# builds of the default features and of the features of the gate; the
# checks of the features tor and ts; clippy with the lints that the gate
# allows; the tests of each crate that reads DNS or a moved value; rustfmt
# of the crates that the patch changes; each Rust toolchain of the
# workflows and build images against the rust-version of podcrates; the
# binary of the release's features for x86_64 musl, built with zig (a debug
# build: the release profile takes LTO), and podssh's static check of it.
cargo run -q -p podssh-todo -- remap Cargo.lock > /dev/null
cargo run -q -p podssh-todo -- check
python3 scripts/check-repo.py
cargo check -q -p podssh-ws -p podssh-relay -p podssh-core -p podssh-probe -p podssh-warp --features podssh-relay/blocking,podssh-relay/quick,podssh-relay/quic,podssh-relay/derp,podssh-relay/piping,podssh-relay/opentunnel,podssh-relay/code,podssh-relay/warp
cargo build -q
cargo build -q -p podssh-cli --features iroh,warp
cargo check -q --all-targets -p podssh-cli -p podssh-iroh -p podssh-warp -p podssh-relay --features podssh-cli/iroh-test,podssh-cli/warp,podssh-warp/stand-in,podssh-relay/warp-stand-in
cargo check -q --all-targets -p podssh-cli -p podssh-tor --features podssh-cli/tor
cargo check -q --all-targets -p podssh-cli -p podssh-ts --features podssh-cli/ts
cargo clippy -q --all-targets -p podssh-ws -p podssh-relay -p podssh-cli -p podssh-ssh -p podssh-warp -p podssh-iroh --features podssh-cli/iroh,podssh-cli/warp -- -D warnings -A clippy::collapsible_if
cargo clippy -q --all-targets -p podssh-relay --features serve,plain-ws,quick,quic -- -D warnings -A clippy::collapsible_if
cargo test -q -p podssh-ws --features plain-ws
cargo test -q -p podssh-relay --all-features --lib --test cache --test limits --test transit --test derp_link --test http_road --test opentunnel_interop --test opentunnel_link --test pair_code --test piping --test quick_edge_warp --test quick_relay --test quick_tunnel --test quick_tunnel_quic --test relay_serve_cleartext --test relay_serve_contract --test relay_serve_h2 --test relay_serve_ipv6 --test relay_serve_once --test relay_serve_publish --test relay_serve_quic --test relay_serve_reverse --test relay_serve_routes --test relay_serve_spares --test relay_serve_sshd --test reverse_carrier --test reverse_dialect --test reverse_restart
cargo test -q -p podssh-cli --lib --test chat_irc_server --test derp_road --test direct_fallback --test direct_proxy --test direct_write_limit --test doctor --test doctor_cleartext --test doctor_hop --test doctor_ipv6 --test doctor_nat --test doctor_stream --test doctor_tls --test doctor_upgrade --test exit --test forwarder_cli --test ipv6_fallback --test node_cut --test opentunnel_road --test ping --test pipe_http --test pipe_ws --test proxy --test relay --test relay_rank --test relay_serve --test relay_serve_node --test settings --test shadowsocks_cli --test ssh_tls_hop --test status --test update
cargo test -q -p podssh-warp --features stand-in
cargo test -q -p podssh-iroh --features test-relay --lib --test relays --test pkarr_lookup --test record_roads
cargo test -q -p podssh-ts --test chain --test convert --test config
# rustfmt of the crates that the patch changes.
cargo fmt -p podssh-ws -p podssh-relay -p podssh-cli -p podssh-ssh -p podssh-warp -p podssh-iroh -p podssh-ts --check
python3 -I "$PODCRATES/scripts/check-consumer-toolchains.py"
cargo zigbuild -q --target x86_64-unknown-linux-musl -p podssh-cli --bin podssh --features "$(sed -n 's/^  RELEASE_FEATURES: //p' .github/workflows/release.yml)"
sh scripts/check-static.sh "${CARGO_TARGET_DIR:-target}/x86_64-unknown-linux-musl/debug/podssh"
