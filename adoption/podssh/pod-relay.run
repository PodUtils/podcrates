# The trial of pod-relay in podssh, at its main 75a5031 (pod-relay.commit),
# which holds the files of the cut to fixes until its take. podssh-relay's
# modules of the relay client are glue over pod-relay, each over podssh's
# context of the process (src/context.rs: the way out of podssh-ws for a
# ProxyChoice, podssh's places of the cache, the PODSSH_* variables read at
# each call, the settings file's and the net's keys, members and rank, the
# process resolver, one shared state for the process); a wrapper keeps each
# function of the old signature, open's Request keeps podssh's form, and
# podssh-cli changes only where a field of a struct changed (the context of a
# mint, a pair, a node and an operator; the dialer of a node's target; the
# resolver of a UDP flow; the ends of a code, whose way out comes again after
# the pins). The node's upgrade, rotations and lines are the process's
# (reverse::node_state, reverse::settings); the role's carrier gives
# pod-relay's Door; a layered handler of the CLI keeps the budget's lines.
# The tests, the plants and the fuzz targets of the moved code leave podssh
# (pod-relay's); the tests of the role (podcrates T-036), of the pairing by
# code at the role's mailbox and of the places of the cache stay; the live
# workflows of the moved tests leave. Each podcrates tag moves to the tag of
# the hand-off. The record with its citations, the repository checks; no
# definition of the moved code stays in podssh; the builds of the default
# features and of the release's features; the checks of the features of the
# gate; clippy with the lints that the gate allows, with each feature of
# podssh-relay; the tests of podssh-relay (its glue, the role, the remaining
# roads) and of podssh-cli that run a node, an operator, a pair, a token, the
# pool, the rank, the failover, a forward session or the role; rustfmt of the
# crates that the patch changes; each Rust toolchain of the workflows and
# build images against the rust-version of podcrates; each test target that
# the gate names; the binary of the release's features for x86_64 musl,
# built with zig (a debug build: the release profile takes LTO), and
# podssh's static check of it.
cargo run -q -p podssh-todo -- remap Cargo.lock > /dev/null
cargo run -q -p podssh-todo -- check
python3 scripts/check-repo.py
! grep -rnE --include='*.rs' -e '(fn|struct|enum) (select_relays|parse_relay_list|RelayList|parse_pool|parse_limits|token_key|MintContext|PairContext|NodeConfig|OperatorConfig|OperatorLimits|CloseSay|Gates|decode_node_frame|encode_node_frame|chunk_for_node|parse_inbound|OperatorPart|Spent|Layered|RelayClose|Racing|NodeOutbound|NodeInbound|Fair)\b' crates
cargo build -q
cargo check -q -p podssh-ws -p podssh-relay -p podssh-core -p podssh-probe -p podssh-warp --features podssh-relay/blocking,podssh-relay/quick,podssh-relay/quic,podssh-relay/derp,podssh-relay/piping,podssh-relay/opentunnel,podssh-relay/code,podssh-relay/warp,podssh-relay/grant,podssh-relay/serve,podssh-relay/bore
cargo build -q -p podssh-cli --features iroh,warp
cargo clippy -q --all-targets -p podssh-ws -p podssh-relay -p podssh-cli -p podssh-core -p podssh-probe -p podssh-todo -p podssh-warp -p podssh-ssh -p podssh-iroh -- -D warnings -A clippy::collapsible_if
cargo clippy -q --all-targets -p podssh-relay --all-features -- -D warnings -A clippy::collapsible_if
cargo clippy -q --all-targets -p podssh-relay --features serve,plain-ws,quick,quic -- -D warnings -A clippy::collapsible_if
cargo test -q -p podssh-relay --all-features
cargo test -q -p podssh-cli --lib --test relay --test relay_rank --test relay_serve --test relay_serve_node --test relay_code --test relay_code_role --test node --test node_cut --test node_moves --test node_restart --test node_expiry --test node_carrier --test operator --test proxy --test status --test exit --test pipe_udp --test road_race --test cloudflare_layer_alive --test net_invite
cargo fmt -p podssh-relay -p podssh-cli --check
python3 -I "$PODCRATES/scripts/check-consumer-toolchains.py"
python3 -I "$PODCRATES/scripts/check-consumer-tests.py"
cargo zigbuild -q --target x86_64-unknown-linux-musl -p podssh-cli --bin podssh --features "$(sed -n 's/^  RELEASE_FEATURES: //p' .github/workflows/release.yml)"
sh scripts/check-static.sh "${CARGO_TARGET_DIR:-target}/x86_64-unknown-linux-musl/debug/podssh"
