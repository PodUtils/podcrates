-fn ungranted(payload: &[u8]) -> Option<(Vec<u8>, Vec<u8>)> {
-    let (head, rest) = payload.split_at_checked(PROOF_LEN)?;
-    let (len, rest) = rest.split_at_checked(2)?;
-    let len = usize::from(u16::from_be_bytes([len[0], len[1]]));
