-/// Keep `learned` of `host`'s UDP `port`.
-pub fn learn(host: &str, port: u16, learned: Learned) {
-    memory().lock().unwrap_or_else(|e| e.into_inner()).insert(key(host, port), (Instant::now(), learned));
-}
