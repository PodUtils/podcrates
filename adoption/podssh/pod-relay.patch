-#[derive(Debug)]
-#[non_exhaustive]
-pub enum Error {
-    /// The call came from a thread that runs a tokio runtime, where blocking
-    /// would stall it.
-    InsideRuntime,
-    /// The runtime, or a thread for a session, could not start.
-    Start(String),
