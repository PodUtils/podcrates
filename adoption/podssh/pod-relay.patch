-    assert_eq!(heads.len(), 1, "one connection: {heads:?}");
-    assert!(heads[0].starts_with(&format!("GET /v1/node/{NAME} HTTP/1.1\r\n")), "{}", heads[0]);
-    assert!(heads[0].contains("\r\nX-Podssh-Proto: 1\r\n"), "the node states its dialect: {}", heads[0]);
-}
