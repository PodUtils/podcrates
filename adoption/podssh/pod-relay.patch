-/// One thing that a socket's reader saw.
-#[derive(Debug)]
-enum Seen {
-    Data(Vec<u8>),
-    Control(String),
-    /// The relay's `close` for the session, on the node's socket.
-    SessionClosed(String),
-    Closed {
-        code: Option<u16>,
