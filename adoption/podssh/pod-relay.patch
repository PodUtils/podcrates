-#[tokio::test]
-async fn a_426_of_another_dialect_ends_the_node_with_the_relay_s_words() {
-    let (relay, heads) = stand_in(Answer::Refuse).await;
-    let exit = node_on(&relay).await.expect("the node ended at the first 426");
