-                Ok(0) => {
-                    let _ = ended.send(());
-                    return;
-                }
-                Ok(n) => tcp.write_all(&buf[..n]).unwrap(),
-                Err(_) => return,
-            }
-        }
-    });
-    (port, ended_rx)
-}
