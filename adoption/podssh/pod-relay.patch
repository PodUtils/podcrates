-/// accept any reason would make each unmatched close a node's refusal.
-fn is_a_node_refusal(reason: &str) -> bool {
-    const REFUSALS: &[&str] = &[
-        "connection refused",
-        "refused",
-        "rejected",
-        "closed",
-        "target closed",
-        "no route to host",
-        "not listening",
-        "eof",
-        "session closed",
-    ];
-    REFUSALS.contains(&reason)
-}
