-    assert!(
-        ECDSA_P384_SHA384.verify_signature(raw, message, der.as_bytes()).is_ok(),
-        "a valid P-384 signature did not verify"
-    );
-    assert!(
-        ECDSA_P384_SHA384.verify_signature(raw, b"a different message", der.as_bytes()).is_err(),
