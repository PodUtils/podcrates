-            // that is not base64.
-            if chunk[3] != b'=' {
-                return Err(INVALID.into());
-            }
-            continue;
-        }
-        let lo = base64_value(chunk[2]).ok_or(INVALID)?;
-        out.push((mid << 4) | (lo >> 2));
-
-        if chunk[3] == b'=' {
-            continue;
-        }
-        let last = base64_value(chunk[3]).ok_or(INVALID)?;
-        out.push((lo << 6) | last);
-    }
-    Ok(out)
-}
-
-fn base64_value(byte: u8) -> Option<u8> {
