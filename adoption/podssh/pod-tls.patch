-fn dial<'a>(addr: SocketAddr, name: &'a str, trust: &'a Trust, proxy: &'a ProxyChoice) -> Dial<'a> {
-    Dial { host: "127.0.0.1", port: addr.port(), server_name: name, trust, proxy, limit: LIMIT, alpn: &[] }
-}
