-/// Only Linux makes a socket of Multipath TCP.
-#[cfg(not(target_os = "linux"))]
-pub fn socket(_addr: &SocketAddr) -> io::Result<TcpSocket> {
-    Err(io::Error::new(io::ErrorKind::Unsupported, "Multipath TCP is made on Linux only"))
