-            libc::IPPROTO_TCP,
-            TCP_IS_MPTCP,
-            (&mut value as *mut libc::c_int).cast(),
-            &mut len,
-        )
-    };
-    (rc == 0).then_some(value != 0)
-}
-
-#[cfg(not(target_os = "linux"))]
-fn server_took(_stream: &TcpStream) -> Option<bool> {
-    None
-}
-
