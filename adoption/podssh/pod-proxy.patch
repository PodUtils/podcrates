-        Some(Step::Reply(COMMAND_NOT_SUPPORTED)) => DialError::ProxyProtocol {
-            proxy: proxy_name,
-            detail: format!("SOCKS5 reply {COMMAND_NOT_SUPPORTED}, command not supported: it has no CONNECT"),
