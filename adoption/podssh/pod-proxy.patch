-                }
-                return Ok((stream, how));
-            }
-            Err(failed) if found.more && Instant::now() < deadline => {
-                match resolve::resolve_from(host, port, deadline, Some(found.source)).await {
-                    Ok(next) => found = next,
-                    Err(_) => return Err(failed),
-                }
-            }
-            Err(failed) => return Err(failed),
-        }
-    }
-}
