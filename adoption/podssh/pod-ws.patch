-/// Bytes that a seed fixes (xorshift64*).
-fn bytes(size: usize, mut seed: u64) -> Vec<u8> {
-    (0..size)
-        .map(|_| {
-            seed ^= seed >> 12;
-            seed ^= seed << 25;
-            seed ^= seed >> 27;
-            (seed.wrapping_mul(0x2545_f491_4f6c_dd1d) >> 56) as u8
-        })
-        .collect()
-}
