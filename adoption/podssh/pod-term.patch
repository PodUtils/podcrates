-/// Run a whole string through the parser, collecting the steps.
-fn run(bytes: &[u8]) -> Vec<Step> {
-    let mut esc = Esc::None;
-    bytes.iter().map(|b| esc.step(*b)).collect()
-}
-
-/// The parser after these bytes.
-fn after(bytes: &[u8]) -> Esc {
-    let mut esc = Esc::None;
-    for b in bytes {
-        let _ = esc.step(*b);
-    }
-    esc
-}
