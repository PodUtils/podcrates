-    pub pty_below: bool,
-    /// A line discipline with no pty is below, as in podvm's server.
-    pub discipline_below: bool,
-    /// The caller selected this discipline: `podssh serve` with no
-    /// `/dev/ptmx`, or a flag.
-    pub selected: bool,
-}
-
-/// Which discipline a session runs.
