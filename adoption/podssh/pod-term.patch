-    all.push(ENTER);
-    all.extend(typed(b"two"));
-    all.extend([ENTER, Step::Key(b"x"), Step::Key(b"\x1b[A"), Step::Key(b"\x1b[A"), Step::Key(b"\x1b[B")]);
-    all.extend([Step::Key(b"\x1b[B"), LEFT, Step::Key(b"\x03"), Step::Key(b"\x1b[A"), Step::Key(b"\x17")]);
