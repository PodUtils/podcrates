-    Refusal::FlowControl,
-    Refusal::CursorAddressing,
-    Refusal::EscapeKey,
-    Refusal::NothingToErase,
-    Refusal::NoMoreHistory,
-    Refusal::AtLineBound,
-    Refusal::LineTooLong,
-    Refusal::NothingToDelete,
-];
