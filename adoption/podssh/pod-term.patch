-    esc: Esc,
-    /// A `\r` just submitted: a `\n` arriving next is its pair, not a second
-    /// line. **READ**, `session.rs:164-167`.
-    last_was_cr: bool,
-    /// The terminal's width in cells, or `None` while no size is known: the
