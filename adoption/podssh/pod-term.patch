-    all.extend([LEFT, LEFT, Step::Output(b"one\ntwo\n"), Step::Output(b"Name: "), Step::Key(b"x")]);
-    all.extend([Step::Output(b"a row longer than sixteen\n"), RIGHT, ENTER, Step::Output(b"after\n")]);
