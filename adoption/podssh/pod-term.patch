-    let mut bs = Discipline::new();
-    assert_eq!(feed(&mut del, b"ab\x7f").local, feed(&mut bs, b"ab\x08").local);
-    assert_eq!(feed(&mut del, b"ab\x7f").local, b"ab\x08 \x08");
