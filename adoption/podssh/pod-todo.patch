-/// Whether `word` is in the prose of `line` as a word, in any case.
-fn has_word(line: &str, word: &str) -> bool {
-    let lower = prose(line).to_ascii_lowercase();
-    let bytes = lower.as_bytes();
-    let mut at = 0;
-    while let Some(pos) = lower[at..].find(word) {
