-/// The body of the `## Heading` section of a document, up to the next `## `.
-pub fn doc_section<'a>(text: &'a str, heading: &str) -> Option<(usize, Vec<(usize, &'a str)>)> {
-    let mut out = None;
-    for (no, line, fenced) in lines_with_fences(text) {
