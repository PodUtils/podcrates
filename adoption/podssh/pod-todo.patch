-                break;
-            }
-            if line[3..].trim() == heading {
-                out = Some((no, Vec::new()));
-            }
-            continue;
-        }
-        if let Some((_, body)) = out.as_mut() {
-            body.push((no, line));
-        }
-    }
-    out
-}
-
-/// The backtick code spans of a line (single backticks).
-pub fn code_spans(line: &str) -> Vec<&str> {
-    let mut out = Vec::new();
-    let mut rest = line;
-    while let Some(open) = rest.find('`') {
