-    socket.set_nagle_enabled(false);
-    socket.set_keep_alive(Some(smoltcp::time::Duration::from_secs(KEEP_ALIVE)));
-    socket.set_timeout(Some(smoltcp::time::Duration::from_secs(TIMEOUT)));
-    socket
-}
