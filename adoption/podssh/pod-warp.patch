-        match faults.len() {
-            0 => Fault::Local("the device has no endpoint of WARP to try".into()),
-            1 => faults.remove(0),
-            n => {
-                let lines: Vec<String> = faults.iter().map(Fault::to_string).collect();
-                like(&faults[0], format!("each of WARP's {n} endpoints failed, in turn: {}", lines.join("; then ")))
