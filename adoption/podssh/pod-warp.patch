-    /// The edge took no certificate of this device: not enrolled, or gone.
-    NotEnrolled(String),
-    /// Another failure of TLS.
-    Tls(String),
-    /// HTTP/2, or the CONNECT, failed.
-    Http2(String),
-    /// The edge answered the CONNECT with this status.
-    Refused { status: u16 },
-    /// Within the limit, no answer.
