-    inbound: AtomicU64,
-    /// Bytes of the tunnel's stream that came in.
-    received: AtomicU64,
-    /// Packets that the stack gave, taken to go out.
-    outbound: AtomicU64,
-    /// Bytes of capsules that HTTP/2 took to send.
