-async fn up<S>(
-    session: Arc<RelaySession<S>>,
-    mut from_pipe: tokio::io::ReadHalf<DuplexStream>,
-    why: Arc<Mutex<Option<String>>>,
-    ended: Arc<watch::Sender<bool>>,
-    mut end: watch::Receiver<bool>,
