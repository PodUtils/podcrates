-    L: AsyncRead + AsyncWrite + Unpin + Send + 'static,
-    A: AsyncRead + AsyncWrite + Unpin + Send,
-    C: FnMut(&Ended) -> F,
-    F: Future<Output = Next<L>>,
-    N: FnMut(Note),
