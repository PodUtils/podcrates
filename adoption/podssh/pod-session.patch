-/// A send or a receive that a target's ICMP error failed: the flow goes on.
-fn refused(e: &io::Error) -> bool {
-    matches!(e.kind(), io::ErrorKind::ConnectionRefused | io::ErrorKind::ConnectionReset)
-}
