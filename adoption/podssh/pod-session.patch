-/// A link through a stand-in relay that cuts nothing.
-fn plain() -> (DuplexStream, DuplexStream) {
-    let (client, relay_client) = tokio::io::duplex(PIPE);
-    let (relay_far, far) = tokio::io::duplex(PIPE);
