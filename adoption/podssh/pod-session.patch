-        let (mut cr, mut cw) = tokio::io::split(relay_client);
-        let (mut fr, mut fw) = tokio::io::split(relay_far);
-        tokio::select! {
-            _ = tokio::io::copy(&mut cr, &mut fw) => {}
-            _ = tokio::io::copy(&mut fr, &mut cw) => {}
