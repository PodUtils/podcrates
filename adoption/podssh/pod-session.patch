-/// Why a resume did not take its session.
-#[derive(Debug, Clone, PartialEq, Eq)]
-enum NotTaken {
-    /// The session ended, on its old link, while this one shook hands; the
-    /// words of its `CLOSE`, empty but for one that a handover ended (T-668).
-    Ended(String),
