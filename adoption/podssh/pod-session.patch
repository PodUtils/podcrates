-pub(super) enum Failed {
-    /// Worth another attempt: the link failed, or took too long.
-    Again(String),
-    /// The far end cannot resume the session.
-    Final(String),
-    /// The far end does not know the session (any more): it ended there, or
-    /// its deadline passed.
