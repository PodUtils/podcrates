-            let _ = ended.send(true);
-            return;
-        }
-    }
-}
-
-/// The far end's bytes, in from each message, until its Close or a failure.
-async fn down<S>(
-    session: Arc<RelaySession<S>>,
-    mut to_pipe: tokio::io::WriteHalf<DuplexStream>,
-    first: Vec<u8>,
