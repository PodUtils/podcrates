-        while let Some((at, piece)) = due.recv().await {
-            tokio::time::sleep_until(at).await;
-            while stalled.load(Ordering::SeqCst) {
-                tokio::time::sleep(MS * 50).await;
-            }
-            if to.write_all(&piece).await.is_err() {
-                return;
-            }
-        }
