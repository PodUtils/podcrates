-    };
-    tokio::select! {
-        () = carried => {}
-        () = ended_by(&mut end) => {}
-    }
-    // The reason first, then the end that a read sees.
-    let _ = ended.send(true);
-    let _ = to_pipe.shutdown().await;
-    let _ = session.send_close(1000, "").await;
-}
