# The trial of pod-proxy in podssh: podssh-ws takes its dial (the proxies,
# SOCKS5, Digest, the race of addresses, Multipath TCP), the HTTP/1.1 heads,
# the GET client and STUN's codec from pod-proxy, with podssh's settings and
# its resolver (dial.rs). The record with its citations moved, and the
# repository checks; the library crates; the builds of the default features
# and of the features of the gate; clippy with the lints that the gate
# allows; the tests of each crate that dials, through a proxy or not, or
# reads the GET client.
cargo run -q -p podssh-todo -- remap Cargo.lock > /dev/null
cargo run -q -p podssh-todo -- check
python3 scripts/check-repo.py
cargo check -q -p podssh-ws -p podssh-relay -p podssh-core -p podssh-probe -p podssh-warp --features podssh-relay/blocking,podssh-relay/quick,podssh-relay/quic,podssh-relay/derp,podssh-relay/piping,podssh-relay/opentunnel,podssh-relay/code,podssh-relay/warp
cargo build -q
cargo build -q -p podssh-cli --features iroh,warp
cargo check -q --all-targets -p podssh-cli -p podssh-iroh -p podssh-warp -p podssh-relay --features podssh-cli/iroh-test,podssh-cli/warp,podssh-warp/stand-in,podssh-relay/warp-stand-in
cargo check -q --all-targets -p podssh-cli -p podssh-tor --features podssh-cli/tor
cargo clippy -q --all-targets -p podssh-ws -p podssh-relay -p podssh-cli -p podssh-ssh -- -D warnings -A clippy::collapsible_if
cargo clippy -q --all-targets -p podssh-relay --features serve,plain-ws,quick,quic -- -D warnings -A clippy::collapsible_if
cargo test -q -p podssh-ws --features plain-ws
cargo test -q -p podssh-relay --all-features --lib --test derp_link --test http_road --test opentunnel_interop --test opentunnel_link --test pair_code --test piping --test quick_edge_warp --test quick_relay --test quick_tunnel --test quick_tunnel_quic --test relay_serve_cleartext --test relay_serve_contract --test relay_serve_h2 --test relay_serve_ipv6 --test relay_serve_once --test relay_serve_publish --test relay_serve_quic --test relay_serve_reverse --test relay_serve_routes --test relay_serve_spares --test relay_serve_sshd --test reverse_carrier --test reverse_dialect --test reverse_restart --test transit
cargo test -q -p podssh-cli --lib --test chat_irc_server --test derp_road --test direct_fallback --test direct_proxy --test direct_write_limit --test doctor --test doctor_cleartext --test doctor_hop --test doctor_ipv6 --test doctor_nat --test doctor_stream --test doctor_tls --test doctor_upgrade --test exit --test forwarder_cli --test ipv6_fallback --test node_cut --test opentunnel_road --test ping --test pipe_http --test pipe_ws --test proxy --test relay --test relay_rank --test relay_serve --test relay_serve_node --test settings --test shadowsocks_cli --test ssh_tls_hop --test status --test update
# rustfmt of the crates that the patch changes.
cargo fmt -p podssh-ws -p podssh-relay -p podssh-cli -p podssh-ssh --check
