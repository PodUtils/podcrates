-        "386" => 0x03,
-        "arm64" => 0xb7,
-        "arm" => 0x28,
-        "riscv64" => 0xf3,
-        "ppc64le" | "ppc64" => 0x15,
-        "s390x" => 0x16,
-        "loong64" => 0x102,
-        "mips64le" | "mips64" => 0x08,
-        _ => return None,
