-    // 1. An explicit `qemu-<arch> ./podvm`. No registration is involved, so
-    //    binfmt_misc says nothing; what qemu does leave is its own environment.
-    let set: Vec<&str> = QEMU_VARS
-        .iter()
-        .copied()
-        .filter(|v| std::env::var_os(v).is_some())
