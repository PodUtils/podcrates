-    Clone(u64),
-    /// Run the body in a re-executed child, which is additionally placed in
-    /// the namespaces named by the flags. A clone that the flags make fail is
-    /// a failed precondition, so the row is a `skip` carrying its errno.
-    Child {
-        ns_flags: u64,
-        body: fn() -> Outcome,
-    },
-}
