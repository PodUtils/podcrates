-/// Restore a mask [`sigblock_shutdown`] reported.
-pub fn sigrestore(old: u64) -> Sysres {
-    unsafe {
-        sys(
-            SYS_RT_SIGPROCMASK,
-            [SIG_SETMASK, &old as *const u64 as u64, 0, 8, 0, 0],
