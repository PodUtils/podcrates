-fn already_there(path: &str) -> Outcome {
-    Outcome::skip(
-        Some(sys::EEXIST),
-        format!("{path} already exists and this probe does not overwrite; remove it and re-run"),
-    )
-}
-
-fn unscratch(path: &str) {
-    let _ = sys::unlink(&c(path));
-}
