-                let hi = u8::from_str_radix(&magic[s + 2..s + 4], 16).ok();
-                match (lo, hi) {
-                    (Some(l), Some(h)) => Some(u16::from(l) | (u16::from(h) << 8)),
-                    _ => None,
-                }
-            }
-            _ => None,
-        }
