-fn read_trimmed(path: &str) -> Result<String, String> {
-    std::fs::read_to_string(path)
-        .map(|s| {
-            s.lines()
-                .map(|l| l.split_whitespace().collect::<Vec<_>>().join(" "))
-                .filter(|l| !l.is_empty())
-                .collect::<Vec<_>>()
-                .join("; ")
-        })
-        .map_err(|e| format!("{path}: {e}"))
