-    }
-    #[cfg(target_arch = "aarch64")]
-    {
-        0xb7
-    }
-    #[cfg(target_arch = "x86")]
-    {
-        0x03
-    }
-    #[cfg(target_arch = "arm")]
-    {
-        0x28
-    }
-    #[cfg(target_arch = "riscv64")]
-    {
-        0xf3
-    }
-    #[cfg(target_arch = "loongarch64")]
-    {
-        0x102
-    }
-    #[cfg(target_arch = "powerpc64")]
-    {
-        0x15
-    }
-    #[cfg(target_arch = "s390x")]
