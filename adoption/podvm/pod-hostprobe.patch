-    /// variable that named it. A reader has to be able to tell.
-    pub source: String,
-    pub outcome: Outcome,
-    /// `None` where `statfs(2)` itself failed; the errno is then in
-    /// [`WriteProbe::space_error`].
-    pub space: Option<Space>,
-    pub space_error: Option<Errno>,
-}
