-    assert!(
-        Rung::Namespace.must_never_claim().contains("/proc"),
-        "the never-claim names no /proc guard"
-    );
-    assert!(
-        s.rejected.iter().all(|r| r.rung != Rung::Namespace),
-        "a fallback was named where none may be"
