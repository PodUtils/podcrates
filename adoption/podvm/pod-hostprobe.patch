-fn candidates() -> Vec<(String, String)> {
-    let mut out: Vec<(String, String)> = FIXED
-        .iter()
-        .map(|p| (p.to_string(), "the candidate list".to_string()))
-        .collect();
-    for var in FROM_ENV {
-        if let Some(v) = std::env::var_os(var) {
