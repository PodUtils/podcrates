-    m.put(agent::AGENT_NAME, agent::AGENT_CMD.as_bytes())
-        .expect("8.3 agent name");
-    m.put(agent::SETUP_NAME, agent::SETUP_CMD.as_bytes())
-        .expect("8.3 setup name");
