-    /// Every file name in the root, in directory order.
-    pub fn list(&self) -> Vec<String> {
-        let mut out = Vec::new();
-        for i in 0..ROOT_ENTRIES {
-            let e = self.entry(i);
-            if e[0] == 0x00 {
-                break;
-            }
-            if e[0] == 0xE5 || e[11] & 0x18 != 0 {
-                continue;
-            }
