-/// What `copy_tree` refused on.
-#[derive(Debug, Clone, PartialEq, Eq)]
-pub struct Refusal {
-    /// The path that could not be replicated, as given.
-    pub path: PathBuf,
-    /// Why, in one sentence.
-    pub why: String,
-}
