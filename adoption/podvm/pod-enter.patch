-            return 1;
-        }
-        while pending.len() < len {
-            match sys::read(fd, &mut buf) {
-                Ok(0) => return 1,
-                Ok(n) => pending.extend_from_slice(&buf[..n as usize]),
-                Err(e) if e == sys::EINTR => continue,
