-/// 3. every **imported symbol** is defined by the libc, read from `.dynsym`;
-/// 4. every **imported version** is one the libc declares.
-pub fn admits(object: &Elf, libc: &Elf) -> Verdict {
-    let refuse = |s: String| Verdict::Refused(s);
