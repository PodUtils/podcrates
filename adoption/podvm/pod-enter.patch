-            name.to_string(),
-            rest.split('.').filter_map(|p| p.parse().ok()).collect(),
-        )
-    };
-    declares
-        .iter()
-        .max_by_key(|s| key(s))
-        .cloned()
-        .unwrap_or_default()
-}
