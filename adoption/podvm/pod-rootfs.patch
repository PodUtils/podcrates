-fn run(root: &Root, opts: &Options) -> Result<Vec<Fixup>> {
-    let files = candidates(root)?;
-    if files.is_empty() {
-        return Ok(vec![Fixup::new(
-            "T-0411",
-            "source-scheme",
-            "",
