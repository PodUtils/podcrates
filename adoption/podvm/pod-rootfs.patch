-const MUSL_MARKERS: &[&str] = &[
-    "lib/ld-musl-x86_64.so.1",
-    "lib/ld-musl-aarch64.so.1",
-    "lib/libc.musl-x86_64.so.1",
-    "lib/libc.musl-aarch64.so.1",
