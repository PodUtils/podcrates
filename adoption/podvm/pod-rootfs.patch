-pub(crate) fn nsswitch(root: &Root, r: &mut Report) {
-    let libc = r.libc;
-    crate::record(r, "T-0410", "nsswitch", run_nsswitch(root, libc));
-}
-
-fn run_nsswitch(root: &Root, libc: Libc) -> Result<Vec<Fixup>> {
