# The trial of pod-tls in podvm: podvm's two TLS modules take pod-tls with no
# default feature (no tokio), with podvm's `ring` passed in.
# crates/podvm-image/src/tls.rs keeps its choice of the host bundle (the
# announced variables, then the paths; the first bundle with a certificate,
# read with pod-tls's PEM reader) and its words; pod-tls reads that bundle
# alone as a CaFile (pod_tls::roots::load), else the compiled-in roots
# (roots_from_compiled_set), and makes the configuration (Context::client_config).
# The verifier that accepts any certificate for a registry named insecure
# stays in podvm. crates/podvm-ssh/src/tls.rs keeps a Context over its host
# bundles (Trust::Default: the first usable bundle and the compiled-in roots)
# and makes the handshake with Context::tls_over_blocking, before the
# WebSocket upgrade, so mux.rs sets the write bound before TLS. podvm drops
# rustls-pemfile and its own webpki-roots; the pod-term tag moves to v0.4.0.
# podvm's tests of the modules that use TLS (tls.rs, registry.rs and transport.rs of
# podvm-image, each test of podvm-ssh, the host bundle of pkg.rs, the probe of
# reach.rs); the integration test of the relay
# where sshd is; clippy of the workspace and rustfmt of the crates, as podvm's
# gate.yml runs them; podvm's record gate; each Rust toolchain of the
# workflows against the rust-version of podcrates; and the binaries `node`
# and `podvm` for x86_64 musl (podvm's .cargo/config.toml: zig cc, static
# CRT), with podcrates' static check.
cargo test -q -p podvm-ssh --lib
cargo test -q -p podvm-image --lib -- tls:: registry:: transport::
cargo test -q -p podvm-complete --lib -- pkg:: reach::
if command -v sshd > /dev/null || [ -x /usr/sbin/sshd ]; then cargo test -q -p podvm-ssh --test mux_two_client; else echo "adoption: no sshd: the test mux_two_client does not run"; fi
cargo clippy -q --workspace --all-targets -- -D warnings
cargo fmt -p podvm-ssh -p podvm-image -p podvm-complete --check
# podvm's gate finds the root of the repository from the path of its binary,
# so it runs from target/release/, with document-state beside it (gate.yml).
cargo build -q --release -p podvm-gate && cargo build -q --release -p podvm-release --bin document-state
mkdir -p target/release && cp "${CARGO_TARGET_DIR:-target}/x86_64-unknown-linux-musl/release/podvm-gate" "${CARGO_TARGET_DIR:-target}/x86_64-unknown-linux-musl/release/document-state" target/release/
# docs/runtime-state.md lists each direct git or registry dependency with its
# locked version. The patch gives the rows of the git form (pod-term and
# pod-tls at 0.4.0); the trial's path form has no row for them. Each other
# row of the patch must be the generated one.
grep -v '^| .pod-' docs/runtime-state.md > target/runtime-state.patch.md && python3 scripts/document-state.py --write && grep -v '^| .pod-' docs/runtime-state.md | diff target/runtime-state.patch.md -
./target/release/podvm-gate
python3 -I "$PODCRATES/scripts/check-consumer-toolchains.py"
cargo build -q -p podvm-ssh --bin node && cargo build -q -p podvm --bin podvm
sh "$PODCRATES/scripts/check-static.sh" "${CARGO_TARGET_DIR:-target}/x86_64-unknown-linux-musl/debug/node"
sh "$PODCRATES/scripts/check-static.sh" "${CARGO_TARGET_DIR:-target}/x86_64-unknown-linux-musl/debug/podvm"
