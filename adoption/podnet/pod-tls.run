# The trial of pod-tls in podnet: podnet takes its roots, its client
# configurations, the clock hint, the notAfter dates and the split of the
# ClientHello from pod-tls, in one context of the process on ring; the edge
# roots of Cloudflare stay in podnet as extra roots. The record, the build,
# clippy, the tests of the library, the integration tests of TLS, of the way
# out, of the reverse relay and of the exit codes, and the size of the files.
cargo run -q -p podnet-todo -- remap Cargo.lock > /dev/null
cargo run -q -p podnet-todo -- check
cargo build -q
cargo clippy -q --all-targets -p podnet -p podnet-netns -- -D warnings
cargo test -q -p podnet --lib
cargo test -q -p podnet --test tls --test egress --test relay_reverse --test cli --test doctor --test api_surface
python3 scripts/check-size.py
# rustfmt of the crates that the patch changes.
cargo fmt --all --check
