# podssh T-643: an operator that offered the net's document takes a node's
# plain proof as an answer and says nothing; the test of its one event with a
# node that holds no document must fail.
ENTRY=T-021
GROUP=e2e
EXPECT='test an_operator_whose_offer_got_a_plain_proof_says_it_once_and_goes_on \.\.\. FAILED'
RUN='cargo test -p pod-e2e --test e2e_net -- an_operator_whose_offer_got_a_plain_proof_says_it_once_and_goes_on'
