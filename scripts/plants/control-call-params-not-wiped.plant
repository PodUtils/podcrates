# The drop of a delegated request does not wipe its params: the token of a
# `load` stays in freed memory, and the search of each freed block finds
# it (T-1023).
ENTRY=T-1023
GROUP=control
EXPECT='freed blocks with a token'
RUN='cargo test -p pod-control --all-features --test wipe no_freed_block_holds_a_token_of_a_line'
LIMIT=900
