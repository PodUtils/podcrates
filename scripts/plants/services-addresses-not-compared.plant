# The watch kind dns-addresses: any address passes; its test must fail.
ENTRY=T-050
GROUP=services
EXPECT='test dns::dns_addresses_hold_each_address_of_the_facts \.\.\. FAILED'
RUN='cargo test -p pod-services-watch --test watches -- dns::dns_addresses_hold_each_address_of_the_facts --exact'
LIMIT=1800
