# A part of a download of the cache names one byte past the end of its
# range: the fuzz target actions_results finds it on its seed of a cache
# entry, past the check of the signature (T-566).
ENTRY=T-566
GROUP=fuzz
EXPECT='bytes at [0-9]+ of'
RUN='cargo test --manifest-path fuzz/Cargo.toml --lib each_target_survives_mutations'
LIMIT=1800
