# podssh T-586: a closing session charged a whole buffer, as before, and so is one
# that keeps its id alone: a keeper that took both from a handover counts a
# budget of two buffers where it holds 220 bytes, so the test of
# session_budget must fail.
ENTRY=T-020
GROUP=session
EXPECT='test a_session_whose_target_ended_holds_only_its_unacknowledged_bytes \.\.\. FAILED'
RUN='cargo test -p pod-session --test session_budget'
