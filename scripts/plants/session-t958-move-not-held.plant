# The old link of a move is not held: after the move is due, it takes the
# application's bytes and acknowledges the far end's until the new link
# greets, and at the rate of a loopback it passes a small cap of the relay
# (T-958, PodUtils/podssh#325).
ENTRY=T-958
GROUP=session
EXPECT='no link met its cap'
RUN='cargo test -p pod-relay --all-features --test layer_cap a_move_at_the_rate_of_a_loopback_stays_under_a_small_cap'
