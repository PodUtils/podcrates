# The watch kind forward-banner: any first line passes as a banner; its test must fail.
ENTRY=T-050
GROUP=services
EXPECT='test ws::forward_banner_puts_the_target_in_the_query \.\.\. FAILED'
RUN='cargo test -p pod-services-watch --test watches -- ws::forward_banner_puts_the_target_in_the_query --exact'
LIMIT=1800
