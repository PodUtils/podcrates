# The watch kind tls-roots: the count of the certificates passes for the certificates; its test must fail.
ENTRY=T-050
GROUP=services
EXPECT='test apis::tls_roots_are_the_certificates_of_the_file_at_the_pin \.\.\. FAILED'
RUN='cargo test -p pod-services-watch --test watches -- apis::tls_roots_are_the_certificates_of_the_file_at_the_pin --exact'
LIMIT=1800
