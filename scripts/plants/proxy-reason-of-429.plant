# request::reason (pod_core::http1::reason) loses the phrase of 429, which
# reads "Error" again, as the relay role's refusals of a full table did; the
# test of the phrases must fail.
ENTRY=T-013
GROUP=core
EXPECT='test http1::tests::each_status_that_podssh_sends_has_its_phrase \.\.\. FAILED'
RUN='cargo test -p pod-core --all-features --lib http1'
LIMIT=900
