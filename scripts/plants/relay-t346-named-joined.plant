# podssh's plant t346-named-joined, on pod-relay's copy of the file.
# podssh T-346: the hosts of other deployments join a list that the user named too,
# which must stay the relay alone; the test of the default list's order must
# fail.
ENTRY=T-025
GROUP=relay
EXPECT='test relay::tests::the_pool_then_other_deployments_follow_the_default_host \.\.\. FAILED'
RUN='cargo test -p pod-relay --lib pool'
LIMIT=1800
