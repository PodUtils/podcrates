# The save of a line takes a stream with no byte as a state (T-1012,
# PodUtils/podvm#618), and each later run loads nothing. The test of the
# save must fail.
ENTRY=T-1012
GROUP=guest
EXPECT='test warm::line::tests::a_save_of_a_line_leaves_a_whole_state_or_nothing \.\.\. FAILED'
RUN='cargo test -p pod-guest --all-features --lib -- warm::line::tests::a_save_of_a_line_leaves_a_whole_state_or_nothing'
LIMIT=1800
