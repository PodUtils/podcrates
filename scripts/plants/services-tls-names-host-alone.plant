# The watch kind tls-names: the address is not checked in the certificate; its test must fail.
ENTRY=T-050
GROUP=services
EXPECT='test files::tls_names_wants_the_address_in_the_certificate \.\.\. FAILED'
RUN='cargo test -p pod-services-watch --test watches -- files::tls_names_wants_the_address_in_the_certificate --exact'
LIMIT=1800
