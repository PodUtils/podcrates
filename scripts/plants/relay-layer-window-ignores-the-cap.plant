# Offer::fit keeps the window of the settings and leaves out the window of
# the cap: the replay buffer bounds the bytes that a new link sends again,
# above a small cap of the relay (T-953).
ENTRY=T-953
GROUP=relay
EXPECT='a window of an eighth of the cap'
RUN='cargo test -p pod-relay --all-features --test layer_cap a_new_link_sends_again_less_than_a_small_cap'
LIMIT=1800
