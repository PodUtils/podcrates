# The watch kind forward-url: the proof of the URL takes each answer of 2xx, with no compare of the word of the run; its test must fail.
ENTRY=T-267
GROUP=services
EXPECT='test forward::forward_url_finds_a_url_that_is_a_page_of_the_relay \.\.\. FAILED'
RUN='cargo test -p pod-services-watch --test watches -- forward::forward_url_finds_a_url_that_is_a_page_of_the_relay --exact'
LIMIT=1800
