# The listener of the udp carrier runs each handshake in the task that
# reads its socket: a peer that stops in its handshake holds each other
# one (T-424).
ENTRY=T-424
GROUP=link
EXPECT='a_peer_that_stops_in_its_handshake_holds_no_other_one stdout ----'
RUN='cargo test -p pod-link --all-features --test udp a_peer_that_stops_in_its_handshake_holds_no_other_one'
LIMIT=1800
