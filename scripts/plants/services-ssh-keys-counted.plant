# The watch kind github-ssh-keys: the count of the fingerprints passes for the fingerprints; its test must fail.
ENTRY=T-050
GROUP=services
EXPECT='test http::github_ssh_keys_are_the_fingerprints_of_the_fact \.\.\. FAILED'
RUN='cargo test -p pod-services-watch --test watches -- http::github_ssh_keys_are_the_fingerprints_of_the_fact --exact'
LIMIT=1800
