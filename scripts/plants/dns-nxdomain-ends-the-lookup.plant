# podnet's rule of NXDOMAIN lost: an answer that the name does not exist
# ends each lookup, as podssh's rule does, so a new name that one operator
# does not know yet is not asked of the next; the test of podnet's issue
# 119 must fail.
ENTRY=T-015
GROUP=dns
EXPECT='test lookup::tests::nxdomain_at_one_operator_asks_the_next_operator \.\.\. FAILED'
RUN='cargo test -p pod-dns --all-features --lib -- lookup::tests'
LIMIT=1800
