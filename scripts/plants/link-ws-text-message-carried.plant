# The pump of the ws carrier gives a text message to the link as bytes:
# a text message is an error of protocol of podnet's carrier (T-506).
ENTRY=T-506
GROUP=link
EXPECT='a text message is an error'
RUN='cargo test -p pod-link --all-features --test ws a_text_message_ends_the_link_with_an_error_of_protocol'
LIMIT=1800
