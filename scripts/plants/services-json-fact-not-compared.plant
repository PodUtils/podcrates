# The watch kind http-json: the value at the pointer is not compared with the fact; its test must fail.
ENTRY=T-050
GROUP=services
EXPECT='test http::http_json_compares_a_fact_and_the_members_of_facts \.\.\. FAILED'
RUN='cargo test -p pod-services-watch --test watches -- http::http_json_compares_a_fact_and_the_members_of_facts --exact'
LIMIT=1800
