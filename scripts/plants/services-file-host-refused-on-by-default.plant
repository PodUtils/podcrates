# 0x0.st, whose terms refuse automated uploads, is on by default: the test
# that each file host has each fact of its kind must fail.
ENTRY=T-528
GROUP=services
EXPECT='test each_file_host_has_each_fact_of_its_kind \.\.\. FAILED'
RUN='cargo test -p pod-services --test file_host -- each_file_host_has_each_fact_of_its_kind --exact'
