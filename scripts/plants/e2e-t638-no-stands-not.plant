# podssh T-638: a no of the node's person stands no time, so the key is asked
# again at once; the test of a no that stands 15 s must fail.
ENTRY=T-021
GROUP=e2e
EXPECT='test person::tests::a_no_stands_fifteen_seconds_with_no_question \.\.\. FAILED'
RUN='cargo test -p pod-e2e --lib -- person::tests::a_no_stands_fifteen_seconds_with_no_question'
