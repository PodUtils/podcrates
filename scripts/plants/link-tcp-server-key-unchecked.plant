# The dialer of the tcp carrier skips the pin of the key of the
# listener: a listener of another key takes the link (T-396).
ENTRY=T-396
GROUP=link
EXPECT='the_dialer_refuses_a_listener_of_another_key_and_names_it stdout ----'
RUN='cargo test -p pod-link --all-features --test tcp_refused'
LIMIT=1800
