# Input mapping: IGNCR is not read, and ICRNL maps the carriage return (T-539).
ENTRY=T-539
GROUP=term
EXPECT='test igncr_drops_a_carriage_return_before_icrnl_maps_it \.\.\. FAILED'
RUN='cargo test -p pod-term --test termios_modes igncr_drops_a_carriage_return_before_icrnl_maps_it -- --exact'
LIMIT=900
