# podssh's plant t637-wait-in-deadline, on pod-relay's copy of the file.
# podssh T-637: the wait at a host's gate counts against the attempt's deadline, so
# a session held past it reads as a host that did not answer; the test of a
# held session that is not a timeout must fail.
ENTRY=T-025
GROUP=relay
EXPECT='test gate::tests::the_wait_never_counts_against_the_deadline \.\.\. FAILED'
RUN='cargo test -p pod-relay --lib -- gate::tests::the_wait_never_counts_against_the_deadline'
