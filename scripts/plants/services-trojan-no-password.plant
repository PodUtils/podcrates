# The watch kind proxy-banner: Trojan sends the hash of an empty password; its test must fail.
ENTRY=T-050
GROUP=services
EXPECT='test ssh::proxy_banner_speaks_trojan_over_tls \.\.\. FAILED'
RUN='cargo test -p pod-services-watch --test watches -- ssh::proxy_banner_speaks_trojan_over_tls --exact'
LIMIT=1800
