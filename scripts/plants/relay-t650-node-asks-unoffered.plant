# podssh's plant t650-node-asks-unoffered, on pod-relay's copy of the file.
# podssh T-650: podssh's node asks for spares of a relay whose hello offers none;
# the test of a relay of the contract, whose first frame from the node must
# be its ready, must fail.
ENTRY=T-025
GROUP=relay
EXPECT='test a_node_asks_nothing_of_a_relay_that_offers_none_or_when_it_wants_none \.\.\. FAILED'
RUN='cargo test -p pod-relay --features pair --test reverse_spares -- a_node_asks_nothing_of_a_relay_that_offers_none_or_when_it_wants_none'
