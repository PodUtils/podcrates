# pod-enter: the parent writes the maps of the lock through /proc/PID of a
# proc that is not of its PID namespace, so it names another process of the
# host (T-1641, the review of PodUtils/podvm#695).
ENTRY=T-1641
GROUP=confine
EXPECT='host root in a PID namespace over the host.s proc: the case of this caller, with no PID namespace \.\.\. FAILED: another refusal'
RUN='sh scripts/ci/root-enter-confine-tests.sh'
LIMIT=1800
