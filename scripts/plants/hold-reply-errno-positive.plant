# The reply of a refusal with a positive errno: the kernel takes a nonzero
# error as the return value of the call, so a refused connect returns 111
# as a success (podnet issue 98); the payload of the hold test must see
# ECONNREFUSED, and the test must fail.
ENTRY=T-166
GROUP=hold
EXPECT='the connect fails with the errno of the reply'
RUN='cargo test -p pod-hold --test hold'
LIMIT=1800
