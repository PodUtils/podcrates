# The Wisp client sends no password extension, and a server that requires
# one refuses the connection: the test of the password must fail.
ENTRY=T-1527
GROUP=egress
EXPECT='test a_server_that_asks_for_a_password_takes_the_login_and_refuses_a_wrong_one \.\.\. FAILED'
RUN='cargo test -p pod-egress --all-features --test wisp_more -- a_server_that_asks_for_a_password_takes_the_login_and_refuses_a_wrong_one'
LIMIT=2400
