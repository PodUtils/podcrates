# pod-enter: the ambient set of the caller crosses the exec of a payload of
# the namespace rung that is not uid 0, so a caller with CAP_SYS_ADMIN in
# it gives the payload that capability with no lock (T-1641, the review of
# PodUtils/podvm#695).
ENTRY=T-1641
GROUP=confine
EXPECT='uid 65534 with CAP_SYS_ADMIN in its ambient set: the case of this caller, with no PID namespace \.\.\. FAILED: remount:/ro gave 0'
RUN='sh scripts/ci/root-enter-confine-tests.sh'
LIMIT=1800
