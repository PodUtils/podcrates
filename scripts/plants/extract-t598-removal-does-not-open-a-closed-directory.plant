# The removal does not open a closed directory, so Place::remove fails
# with EACCES on a tree that the image closed (T-598). The proof runs as
# uid 1000 when the test runs as root.
ENTRY=T-598
GROUP=extract
EXPECT='the removal of a closed tree failed'
RUN='cargo test -p pod-extract --all-features --lib drive::dirmodes'
LIMIT=1800
