# The child opens the paths of the rules before it puts the passed
# descriptors onto their numbers: a rule loses its file to a passed
# descriptor (T-108).
ENTRY=T-108
GROUP=confine
EXPECT='test a_passed_descriptor_takes_the_place_of_no_rule \.\.\. FAILED'
RUN='cargo test -p pod-enter --all-features --test confine'
LIMIT=1800
