# The list of a NoPlatform refusal gives no os.version: two Windows
# versions read as one windows/amd64 (T-585).
ENTRY=T-585
GROUP=oci
EXPECT='left: "windows/amd64, linux/amd64"'
RUN='cargo test -p pod-oci --all-features --lib the_offered_list_has_no_repeat_no_attestation_and_the_os_version'
LIMIT=1800
