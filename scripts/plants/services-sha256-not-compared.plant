# The watch kind http-sha256: any sum passes; its test must fail.
ENTRY=T-050
GROUP=services
EXPECT='test files::http_sha256_sums_the_file_and_checks_its_length \.\.\. FAILED'
RUN='cargo test -p pod-services-watch --test watches -- files::http_sha256_sums_the_file_and_checks_its_length --exact'
LIMIT=1800
