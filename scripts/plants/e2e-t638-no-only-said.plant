# podssh T-638: the person's no is said in the node's event, and the session
# goes on to the target; the test of a no, which must reach no target, must
# fail.
ENTRY=T-021
GROUP=e2e
EXPECT='test a_no_reaches_no_target_and_the_operator_hears_only_not_let_in \.\.\. FAILED'
RUN='cargo test -p pod-e2e --test person -- a_no_reaches_no_target_and_the_operator_hears_only_not_let_in'
