# A mode of 4755, 2755 or 6755 is not set again after the write: a user
# that is not root loses S_ISUID and S_ISGID (T-581, PodUtils/podvm#342).
# The proof runs as uid 1000 when the test runs as root.
ENTRY=T-581
GROUP=extract
EXPECT='lost its set-id bits'
RUN='cargo test -p pod-extract --all-features --lib drive::setid'
LIMIT=1800
