# pod-guest: the polls of freeze and running wait the fixed 5 s for one
# answer and not the rest of the bound of the caller, so a late answer of
# query-migrate or query-status fails the save or the load (T-1037).
ENTRY=T-1037
GROUP=guest
EXPECT='test warm::line::tests_late::a_late_answer_of_query_migrate_within_the_bound_is_no_failure \.\.\. FAILED'
RUN='cargo test -p pod-guest --all-features --lib -- warm::line::tests_late'
LIMIT=1800
