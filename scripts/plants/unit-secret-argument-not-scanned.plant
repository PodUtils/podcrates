# The scan of secrets skips the arguments of a unit: a token in the command
# line of a service, which each user reads, passes the check (T-102).
ENTRY=T-102
GROUP=unit
EXPECT='a token in an argument'
RUN='cargo test -p pod-unit --all-features --lib secret::tests::a_token_in_an_argument_is_refused_and_not_named'
LIMIT=900
