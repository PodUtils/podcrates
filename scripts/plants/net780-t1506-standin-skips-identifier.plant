# The stand-in CA skips the check of the digest of the acmeIdentifier
# (T-1506). The test of the certificates of TLS-ALPN-01 must fail.
ENTRY=T-1506
GROUP=acme
EXPECT='test the_stand_in_refuses_a_certificate_of_tls_alpn_01_that_rfc_8737_does_not_allow \.\.\. FAILED'
RUN='cargo test -p pod-acme --all-features --test standin_checks the_stand_in_refuses_a_certificate_of_tls_alpn_01_that_rfc_8737_does_not_allow -- --exact'
LIMIT=900
