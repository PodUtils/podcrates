# A clear of the board sends a retained PUBLISH with a byte in it: the
# broker keeps that byte as the note, so a take after the clear finds it;
# the test of the board must fail, on the stand-in and on Eclipse Mosquitto
# (scripts/ci/mosquitto-tests.sh).
ENTRY=T-417
GROUP=wormhole
EXPECT='test a_board_puts_takes_and_clears_a_note \.\.\. FAILED'
RUN='cargo test -p pod-wormhole --features standin --test board -- a_board_puts_takes_and_clears_a_note --exact'
