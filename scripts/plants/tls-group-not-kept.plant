# The store of sessions offers this process's group alone, and none that a
# run before kept, so a later run offers X25519 again to a server that takes
# P-256 alone; the test of two runs, which wants no HelloRetryRequest in the
# second, must fail.
ENTRY=T-012
GROUP=tls
EXPECT='test a_later_run_offers_the_group_that_the_server_took \.\.\. FAILED'
RUN='cargo test -p pod-tls --all-features --test tls_group -- a_later_run_offers_the_group_that_the_server_took'
LIMIT=1800
