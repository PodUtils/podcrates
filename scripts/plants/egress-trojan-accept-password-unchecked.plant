# The parser of the accept side skips the compare of the password's hash: a
# request of another password is taken, and the test of the wrong password
# must fail.
ENTRY=T-1531
GROUP=egress
EXPECT='test trojan::accept::tests::another_password_is_a_wrong_password_and_not_a_trojan_request_is_not \.\.\. FAILED'
RUN='cargo test -p pod-egress --all-features --lib trojan::accept'
