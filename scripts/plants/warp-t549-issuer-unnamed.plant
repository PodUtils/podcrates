# The pin of the front door: the failure does not name the issuer of the certificate that the door showed; its test must fail.
ENTRY=T-549
GROUP=warp
EXPECT='test a_door_that_shows_another_certificate_names_its_issuer_and_a_proxy_only_on_its_road \.\.\. FAILED'
RUN='cargo test -p pod-warp --test net -- a_door_that_shows_another_certificate_names_its_issuer_and_a_proxy_only_on_its_road --exact'
LIMIT=1800
