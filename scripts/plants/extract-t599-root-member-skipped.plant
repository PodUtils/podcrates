# The root member (./) adds to LayerStats::skipped and names ArchiveRoot,
# so a caller reports an image that lost nothing as incomplete (T-599,
# PodUtils/podvm#352).
ENTRY=T-599
GROUP=extract
EXPECT='the root member counted as skipped'
RUN='cargo test -p pod-extract --all-features --lib drive::the_root_member_is_not_a_skipped_entry'
LIMIT=1800
