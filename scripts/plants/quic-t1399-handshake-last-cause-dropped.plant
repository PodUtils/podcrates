# pod-quic: the race of handshakes says the last address with to_string()
# and keeps no cause, so a failed UDP socket reads "no UDP socket for QUIC"
# with no cause (PodUtils/podssh#360, T-1399). The test of the cause must
# fail.
ENTRY=T-1399
GROUP=link
EXPECT='test connect::tests::a_failed_socket_keeps_its_cause_in_the_line_of_the_race \.\.\. FAILED'
RUN='cargo test -p pod-quic --lib -- connect::tests::a_failed_socket_keeps_its_cause_in_the_line_of_the_race --exact'
LIMIT=1800
