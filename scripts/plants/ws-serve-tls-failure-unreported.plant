# The accept loop of pod-ws gives no failed TLS handshake to the caller of
# serve_reporting: the ws listener of pod-link never learns that a client
# refused its key (T-557).
ENTRY=T-557
GROUP=ws
EXPECT='the refusal in time'
RUN='cargo test -p pod-link --all-features --test ws the_dialer_refuses_a_listener_of_another_key_and_names_it'
LIMIT=1800
