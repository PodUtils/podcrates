# podssh T-638: a question that is out counts for nothing, so each session of
# one key asks its own; the test of two sessions and one question must fail.
ENTRY=T-021
GROUP=e2e
EXPECT='test person::tests::two_sessions_of_one_key_raise_one_question \.\.\. FAILED'
RUN='cargo test -p pod-e2e --lib -- person::tests::two_sessions_of_one_key_raise_one_question'
