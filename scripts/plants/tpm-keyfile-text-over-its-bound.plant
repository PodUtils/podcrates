# A key file takes a description or the name of a signed policy of
# more than MAX_TEXT (256) bytes, in the reader and in the writer
# (T-1219).
ENTRY=T-1219
GROUP=tpm
EXPECT='an_oversize_field_is_refused \.\.\. FAILED'
RUN='cargo test -p pod-tpm --all-features --test keyfile_bounds an_oversize_field_is_refused'
LIMIT=900
