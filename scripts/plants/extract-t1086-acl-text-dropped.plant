# The text form of a POSIX ACL (`SCHILY.acl.access`) is dropped with no
# word: the ACL is neither set nor named (T-1086).
ENTRY=T-1086
GROUP=extract
EXPECT='the ACL with a name is not named'
RUN='cargo test -p pod-extract --all-features --lib drive::acls::the_acls_of_gnu_tar_are_set_or_named_and_the_modes_stay'
LIMIT=900
