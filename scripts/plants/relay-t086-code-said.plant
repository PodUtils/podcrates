# podssh's plant t086-code-said, on pod-relay's copy of the file.
# podssh T-086: the giver says its code in a line of the run, which a log keeps;
# the test that no line and no Debug holds a word of the code must fail.
ENTRY=T-025
GROUP=relay
EXPECT='test the_code_is_in_no_line_and_no_debug \.\.\. FAILED'
RUN='cargo test -p pod-relay --features pair,code --test pair_code -- the_code_is_in_no_line_and_no_debug'
