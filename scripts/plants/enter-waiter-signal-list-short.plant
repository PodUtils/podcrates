# pod-enter: the waiter blocks SIGHUP, SIGINT and SIGTERM only, so a SIGUSR1 does not reach the payload (T-995).
ENTRY=T-995
GROUP=enter
EXPECT='a_sigusr1_of_the_waiter_reaches_the_payload'
RUN='cargo test -p pod-enter --all-features --lib child::tests::a_sigusr1_of_the_waiter_reaches_the_payload'
LIMIT=900
