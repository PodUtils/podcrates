# The reader of the relay's messages starts each call at an empty buffer,
# so a read that a timeout cancelled loses the bytes that it read, and the
# next message starts in the middle of one; the stable test of the fuzz
# target gsr_message must fail on the cancelled reads.
ENTRY=T-086
GROUP=fuzz
EXPECT='test tests::each_target_survives_mutations \.\.\. FAILED'
RUN='cargo test --manifest-path fuzz/Cargo.toml --lib'
LIMIT=1800
