# pod-hostprobe: the refusal of the machine tier joins its legs with a space, so the name of a leg runs into the reason of the leg before it; its test must fail (T-570).
ENTRY=T-570
GROUP=hostprobe
EXPECT='test machine::tests::the_legs_of_a_refusal_are_separated_where_a_reason_ends \.\.\. FAILED'
RUN='cargo test -p pod-hostprobe --lib -- machine::tests::the_legs_of_a_refusal_are_separated_where_a_reason_ends --exact'
LIMIT=1800
