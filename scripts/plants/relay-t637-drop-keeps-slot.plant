# podssh's plant t637-drop-keeps-slot, on pod-relay's copy of the file.
# podssh T-637: a lease dropped with no verdict, as by a race that kept another
# host, keeps its slot, so the gate fills and admits nobody; the test of a
# dropped lease must fail.
ENTRY=T-025
GROUP=relay
EXPECT='test gate::tests::a_lease_dropped_with_no_verdict_frees_its_slot \.\.\. FAILED'
RUN='cargo test -p pod-relay --lib -- gate::tests::a_lease_dropped_with_no_verdict_frees_its_slot'
