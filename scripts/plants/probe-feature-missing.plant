# The static probe does not turn on `blocking` of pod-proxy. The run plants
# it with one edit of the line of pod-proxy: a patch broke each time a new
# crate added a line beside it. The grep fails the plant (no EXPECT) if the
# line is not there to edit.
ENTRY=T-095
GROUP=lint
EXPECT='pod-proxy: feature blocking is in no static probe'
RUN='grep -q "^pod-proxy = { workspace = true, features = \[\"blocking\", \"ech\"\] }" examples/static-probe/Cargo.toml && sed -i "s/^pod-proxy = { workspace = true, features = \[\"blocking\", \"ech\"\] }/pod-proxy = { workspace = true, features = [\"ech\"] }/" examples/static-probe/Cargo.toml && python3 -I scripts/check-probe.py --no-tree'
LIMIT=60
SWITCH=1
