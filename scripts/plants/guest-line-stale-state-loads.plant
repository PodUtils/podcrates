# The check of a saved line compares only the first line of the
# fingerprint, so a state of another kernel or image loads (T-1012,
# PodUtils/podvm#618). The test of the restore must fail.
ENTRY=T-1012
GROUP=guest
EXPECT='test warm::line::tests::a_saved_line_restores_and_a_changed_fingerprint_is_refused \.\.\. FAILED'
RUN='cargo test -p pod-guest --all-features --lib -- warm::line::tests::a_saved_line_restores_and_a_changed_fingerprint_is_refused'
LIMIT=1800
