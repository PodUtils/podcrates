# The watch kind dns-srv: any SRV record passes; its test must fail.
ENTRY=T-050
GROUP=services
EXPECT='test dns::dns_srv_names_the_hosts_and_the_port_of_the_role \.\.\. FAILED'
RUN='cargo test -p pod-services-watch --test watches -- dns::dns_srv_names_the_hosts_and_the_port_of_the_role --exact'
LIMIT=1800
