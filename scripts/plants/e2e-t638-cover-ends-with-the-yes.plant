# podssh T-638: a yes covers its key 120 s from the answer, whatever session
# is open, so a device that stays is asked again; the test of the cover while
# a session is open must fail.
ENTRY=T-021
GROUP=e2e
EXPECT='test person::tests::a_yes_covers_the_key_while_a_session_is_open_and_120_s_after \.\.\. FAILED'
RUN='cargo test -p pod-e2e --lib -- person::tests::a_yes_covers_the_key_while_a_session_is_open_and_120_s_after'
