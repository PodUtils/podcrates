# podssh T-633: the one comparison of an answer's member reads `is_some()`, so a
# `false`, a string or a number offers a feature and confirms a guarantee;
# the test of each kind's noes must fail.
ENTRY=T-020
GROUP=session
EXPECT='test answer::tests::only_true_offers \.\.\. FAILED'
RUN='cargo test -p pod-session --lib -- answer::tests'
