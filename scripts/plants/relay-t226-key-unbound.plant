# podssh's plant t226-key-unbound, on pod-relay's copy of the file.
# podssh T-226: the node no longer checks that the channel proved the grant's own
# key, so a grant that leaks lets in whoever holds it; the test of each other
# grant, which a key that is not the certificate's must meet, must fail.
ENTRY=T-025
GROUP=relay
EXPECT='test each_other_grant_is_refused_before_the_node_dials \.\.\. FAILED'
RUN='cargo test -p pod-relay --features pair,grant --test grant -- each_other_grant_is_refused_before_the_node_dials'
