# The watch kind github-files: the files are summed at the pin alone; its test must fail.
ENTRY=T-050
GROUP=services
EXPECT='test apis::github_files_sums_each_file_at_the_pin_and_at_the_newest \.\.\. FAILED'
RUN='cargo test -p pod-services-watch --test watches -- apis::github_files_sums_each_file_at_the_pin_and_at_the_newest --exact'
LIMIT=1800
