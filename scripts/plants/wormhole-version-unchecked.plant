# An end takes the other end's version phase when it does not open, so a
# wrong code is no longer told at the key's confirmation; the test of a wrong
# code, which must fail both ends with it and spend the code, must fail.
ENTRY=T-022
GROUP=wormhole
EXPECT='test a_wrong_code_ends_both_ends_and_spends_the_code \.\.\. FAILED'
RUN='cargo test -p pod-wormhole --features standin --test mailbox -- a_wrong_code_ends_both_ends_and_spends_the_code'
