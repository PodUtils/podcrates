# podssh's plant t637-each-failure-moves, on pod-relay's copy of the file.
# podssh T-637: each failure of a closed gate moves its ladder, the stale ones of a
# wave too, so 8 failures together wait 30 s where one wave should wait 1 s;
# the test of a cold wave must fail.
ENTRY=T-025
GROUP=relay
EXPECT='test gate::tests::a_cold_wave_dials_at_most_eight_and_its_failures_move_the_ladder_once \.\.\. FAILED'
RUN='cargo test -p pod-relay --lib -- gate::tests::a_cold_wave_dials_at_most_eight_and_its_failures_move_the_ladder_once'
